# syslog_time($month,$day,$hour,$min,$sec) - time of a classic syslog
# line (no year: --year or the year of a newer line with an explicit date,
# decremented when the month grows while reading the log backwards); undef for an impossible date (e.g. Feb 29)
sub syslog_time($$$$$) {
  my ($mo,$dd,$hh,$mi,$ss) = @_;

  if (defined $pm && $mo > $pm) {
    $year--;
    print "Year changed to ($year)\n" if ($verbose);
  }
  $pm = $mo;
  my $tt = eval { timelocal($ss,$mi,$hh,$dd,$mo,$year) };
  print "skipping line with invalid date ($dd.".($mo+1).".$year)\n"
    if (!defined $tt && $verbose);
  return $tt;
}

# normip($ip) - address as stored in the database (IPv6 compressed,
# lower case)
sub normip($) {
  my ($a) = @_;

  return $a unless (defined $a && $a =~ /:/);
  my $x = ip_expand_address(lc($a),6);
  return (defined $x ? ip_compress_address($x,6) : lc($a));
}

# kea_log_time($line) - time of a KEA log line: KEA's own log file
# (2026-11-02 12:00:00.123), RFC 3339 / RFC 5424 syslog (with time zone)
# or classic syslog (Nov  2 12:00:00, optionally with a <pri> prefix)
sub kea_log_time($) {
  my ($line) = @_;

  $line =~ s/^<\d+>(?:1\s+)?//;
  if ($line =~ /^(\d{4})-(\d\d)-(\d\d)[ T](\d\d):(\d\d):(\d\d)(?:[.,]\d+)?(Z|[+-]\d\d:?\d\d)?\s/) {
    my ($Y,$M,$D,$h,$mi,$s,$tz) = ($1,$2,$3,$4,$5,$6,$7);
    my $tt;
    if (!defined $tz) {
      $tt = eval { timelocal($s,$mi,$h,$D,$M-1,$Y) };
    } else {
      $tt = eval { timegm($s,$mi,$h,$D,$M-1,$Y) };
      if (defined $tt && $tz ne 'Z') {
	my ($sign,$oh,$om) = ($tz =~ /^([+-])(\d\d):?(\d\d)$/);
	$tt -= ($oh * 3600 + $om * 60) * ($sign eq '+' ? 1 : -1);
      }
    }
    # the explicit date sets the year and month for older classic
    # syslog lines (read backwards)
    if (defined $tt) {
      my @lt = localtime($tt);
      ($pm,$year) = ($lt[4],$lt[5] + 1900);
    }
    return $tt;
  }
  if ($line =~ /^(\S{3})\s+(\d+)\s+(\d+):(\d+):(\d+)\s/ && defined $months{$1}) {
    return syslog_time($months{$1},$2,$3,$4,$5);
  }
  return undef;
}

# while (<FILE>) {
foreach (@reverse_lines) { # Process array instead of file. ****

    # show visual progress ...
    if ($progress) {
	if (++$ln % 100) {
	    printf "\rline [ %s ]  %s",$ln,$pa[$ln % 4];
	} elsif ($ln % 10) {
	    printf "  %s",$pa[$ln % 4];
	}
    }

    # KEA: DHCP4_LEASE_ALLOC/REUSE "<client>: lease <ip> has been ...",
    #      DHCP6_LEASE_ALLOC/REUSE "<client>: lease for address <ip> and
    #      iaid=<n> has been ..." (client = [hwtype=1 <mac>], duid=[<duid>])
    if (/\b(DHCP[46])_LEASE_(?:ALLOC|REUSE)\s+(.*)$/) {
	my ($kfam,$msg) = ($1,$2);
	my ($kip,$kmac,$kduid);
	if ($kfam eq 'DHCP4' &&
	    $msg =~ /:\s+lease\s+(\S+)\s+has been (?:allocated|reused)/) {
	    $kip = $1;
	} elsif ($kfam eq 'DHCP6' &&
		 $msg =~ /:\s+lease for address\s+(\S+)\s+and iaid=\S+\s+has been (?:allocated|reused)/) {
	    $kip = $1;
	} else {
	    next;
	}
	$kmac = $1 if ($msg =~ /\[hwtype=\d+\s+([0-9a-fA-F:]+)\]/);
	$kduid = $1 if ($msg =~ /\bduid=\[([0-9a-fA-F:]+)\]/);
	$t = kea_log_time($_);
	next unless (defined $t);
	$first_date = $t unless (defined $first_date);
	($host) = (/^(?:<\d+>(?:1\s+)?)?\S+\s+(?:\d+\s+\d+:\d+:\d+\s+)?(\S+)\s+kea-dhcp[46]/);
	$via = (defined $host ? "$host " : '') . ($kfam eq 'DHCP4' ? 'kea-dhcp4' : 'kea-dhcp6');
	$ip = normip($kip);
	$iptime{$ip} = [$t, (defined $kmac ? $kmac : ''), $via] if ($ip && !$iptime{$ip});
	if ($kduid) {
	    (my $du = uc($kduid)) =~ s/[^0-9A-F]//g;
	    $duidhash{$du} = { DHCPACK => $t, 'DHCPACK-via' => $via, 'DHCPACK-ip' => $ip }
	      unless ($duidhash{$du});
	}
	if ($kmac) {
	    ($mac = uc($kmac)) =~ s/[^A-F0-9]//g;
	    if (length($mac) == 12 && !defined $hash{$mac}) {
		$hash{$mac} = { DHCPACK => $t, 'DHCPACK-via' => $via, 'DHCPACK-ip' => $ip };
		$iphash{$ip} = $mac if ($ip);
	    }
	}
	next;
    }

    if (/^(\S+)\s+(\d+)\s+(\d+):(\d+):(\d+)\s+((\S+)\s+dhcpd(?:\[\d+\])?:(\s+\[.+?\])?|\[dhcpd\])\s(.*)$/) {
	$m=$months{$1}; $d=$2; $hour=$3; $min=$4; $sec=$5; $host=$7; $rest=$9;
 	print "[$1] [$2] [$3]\n" if ($debug > 1);
	$t = syslog_time($m,$d,$hour,$min,$sec);
	next unless (defined $t);
    } elsif (/^<\d{2}>1\s+(\S+)\s+(\S+)\s+dhcpd\s+(?:\W+)(.*)$/) { # systemd log format
	print "[$1] [$2] [$3]\n" if ($debug > 1);
	$t = UnixDate(ParseDate("$1"),"%s");
	($sec,$min,$hour,$d,$m,$year) = split(' ',strftime("%S %M %H %d %m %Y",localtime($t)));
	$host = $2;
	$rest = $3;
    } elsif (/^<\d{2}>1\s(\S+)\s+(\S+)\s+dhcpd\s+\d+[^A-Z]+(.*)$/) { # rfc3999 systemd log format
	print "[$1] [$2] [$3]\n" if ($debug > 1);
	$t = UnixDate(ParseDate("$1"),"%s");
	($sec,$min,$hour,$d,$m,$year) = split(' ',strftime("%S %M %H %d %m %Y",localtime($t)));
	$host = $2;
	$rest = $3;
    } else {
	next;
    }

    $first_date = $t unless (defined $first_date);
    # hostname info not currently used anywhere ...
    $first_host = $host unless (defined $first_host);
# This test is not very meaningful. ****
# fatal("Log contains new year or time shifts backwards!")
#   if (($t+86400) < $first_date);
    $mac=''; $cmd=''; $ip=''; $via='';
    #print "$m,$d,$hour,$min,$sec,$host,$rest\n";

    if ($rest =~ /^(DHCPDISCOVER|BOOTREQUEST)\s+from\s+(\S+)\s+via\s+(.*)$/) {
	print "$1 $2 $3\n" if ($debug == 5);
	$cmd=$1;
	$mac=$2;
	$via=$3;
    } elsif ($rest =~ /^(DHCPREQUEST)\s+for\s+(\S+)(\s+\((\S+)\))?\s+from\s+(\S+)\s+via\s+(.*)$/) {
	$cmd=$1;
	$mac=$5;
	$via=$6;
	print "$1 $2 ($4) $5 '$6' : $mac\n" if ($debug == 6);
    } elsif ($rest =~ /^(DHCPACK|DHCPNAK)\s+on\s+(\S+)\s+to\s+(\S+)\s+via\s+(.*)$/) {
	$cmd=$1;
	$ip=$2;
	$mac=$3;
	$via=$4;
	print "$1 $2 $3 '$4'\n" if ($debug == 6);
    } elsif ($rest =~ /^(BOOTREPLY)\s+for\s+(\S+)\s+to\s+(\S+)\s+\((\S+)\)\s+via\s+(.*)$/) {
	$cmd=$1;
	$ip=$2;
	$mac=$4;
	$via=$5;
	print "$1 $2 $3 $4 '$5'\n" if ($debug == 6);
    }

    next unless ($cmd eq 'DHCPACK' || $cmd eq 'BOOTREPLY');

# **** Don't let older data overwrite newest data.
# **** Store newest occurrence of each ip.
# **** IPv6s in db are compressed; compress IPv6s from log, too.
    $ip = normip($ip);
    if ($ip && !$iptime{$ip}) { $iptime{$ip} = [$t, $mac, $via]; }

    if ($mac) {
	my $origmac=$mac;
	$mac = uc($mac);
	$mac =~ s/[^A-F0-9]//g;
	next if (length($mac) == 32); # ignore those damn MS RAS requests ...
	unless (length($mac)==12) {
	    print "$file($.): invalid mac addres found ($origmac)\n";
	    next;
	}
	#print "$t : $mac\n";
	next if (defined $hash{$mac}); # Store each host only once (latest record). ****
#   $hash{$mac}={} unless (defined $hash{$mac});
	$hash{$mac}={}; # ****
	$hash{$mac}->{$cmd}=$t;
	$hash{$mac}->{"$cmd-via"}=$via;
	$hash{$mac}->{"$cmd-ip"}=$ip;
	$iphash{$ip}=$mac if ($ip);
    }

}

if ($progress) {
    printf "\rline [ %s ]    \n",$ln
}

close(FILE);
undef @reverse_lines; # Drop the array to free memory. ****

$hashcount = (keys %hash);
print "Done. (found $hashcount different MACs)\n" if ($verbose);

print "Fetching host info from database ...\n" if ($verbose);
undef @q;
db_query("SELECT h.id,h.ether,h.dhcp_date,h.domain,a.ip,h.type,h.duid " .
	 "FROM hosts h JOIN zones z ON h.zone=z.id " .
	 " LEFT JOIN a_entries a ON a.host=h.id " .
#	 "WHERE z.server=$serverid AND h.type=1",\@q);
	 "WHERE z.server=$serverid AND (h.type=1 OR h.type=9)",\@q); # Include "DHCP only" hosts. ****
$c=@q;
print "Done. ($c suitable host entries found in database)\n" if ($verbose);
$matchbyip=0;
$notfounds=0;
$notupdated=0;

if ($debug == 9) {
 print "-- hash --\n";
 print Dumper(%hash);
 print "-- \@q --\n";
 print Dumper(@q);
 exit(0);
}

print "Matching hosts ...\n" if ($verbose);

# lease record of a MAC: the newest of DHCPACK and BOOTREPLY
sub mac_record($) {
  my ($m) = @_;
  my $h = $hash{$m};
  my ($t,$v,$a) = (0,undef,undef);

  return undef unless ($h);
  if (defined $h->{DHCPACK} && $h->{DHCPACK} > 0) {
    ($t,$v,$a) = ($h->{DHCPACK},$h->{'DHCPACK-via'},$h->{'DHCPACK-ip'});
  }
  if (defined $h->{BOOTREPLY} && $h->{BOOTREPLY} > $t) {
    ($t,$v,$a) = ($h->{BOOTREPLY},$h->{'BOOTREPLY-via'},$h->{'BOOTREPLY-ip'});
  }
  return { t => $t, via => $v, ip => $a, ident => dhcpether($m) };
}

for $i (0..$#q) {
    my ($rec,@cand);
    $mac  = defined($q[$i][1]) ? uc($q[$i][1]) : "";
    $ip   = $q[$i][4];
    $type = $q[$i][5]; # ****
    ($hduid = uc(defined $q[$i][6] ? $q[$i][6] : '')) =~ s/[^0-9A-F]//g;

    if ($type == 1) {
	# the host's MAC (DHCPv4) and DUID (KEA DHCPv6) leases, the newest wins
	push @cand, [ 'MAC', mac_record($mac) ] if ($mac ne '' && defined $hash{$mac});
	if ($hduid ne '' && $duidhash{$hduid}) {
	    my $d = $duidhash{$hduid};
	    push @cand, [ 'DUID', { t => $d->{DHCPACK}, via => $d->{'DHCPACK-via'},
				    ip => $d->{'DHCPACK-ip'},
				    ident => 'DUID ' . dhcpduid($hduid) } ];
	}
	# try to lookup host record by IP when MAC/DUID lookup fails ...
	if (!@cand && defined($ip) && $iphash{$ip} && defined $hash{$iphash{$ip}}) {
	    push @cand, [ 'IP', mac_record($iphash{$ip}) ];
	}
	unless (@cand) {
	    $notfounds++;
	    next;
	}
	# same lease seen by MAC and DUID (KEA DHCPv6): report the DUID
	($matchtype,$rec) = @{(sort { $b->[1]{t} <=> $a->[1]{t} ||
				     ($b->[0] eq 'DUID') <=> ($a->[0] eq 'DUID') } @cand)[0]};
	$matchbyip++ if ($matchtype eq 'IP');
    } elsif (defined($ip) and $iptime{$ip}) { # DHCP only. ****
	$rec = { t => $iptime{$ip}[0], via => $iptime{$ip}[2], ip => $ip,
		 ident => dhcpether('') };
	$matchtype = 'IP';
	$matchbyip++;
    } else { # ****
	$notfounds++;
	next;
    }

    $id     = $q[$i][0];
    $date   = (defined($q[$i][2]) and $q[$i][2] > 0) ? $q[$i][2] : 0;
    $domain = $q[$i][3];
    ($t,$via,$ip) = ($rec->{t},$rec->{via},$rec->{ip});

# This test is no longer very meaningful. ****
  next unless ($t > 0); # skip unless time from DHCPACK/BOOTREPLY

  if ( ($t <= $date) &&
       ($date < ($timenow + 30*86400)) # handle bogus host dhcp_dates
     ) {
    print "notupdating: $domain ($rec->{ident}) : $t : $date\n"
      if ($debug);
    $notupdated++;
    next;
  }

  print "match by IP: $domain $id $date : $t ($via,$ip)\n"
    if ($debug && $matchtype eq 'IP');
  push @match, [$id,$t,"$ip for $rec->{ident} via $via"];
  $matchhash{$id}=$matchtype;
}

print "$matchbyip host(s) matched using IP\n",
      "$notupdated host(s) info not updated\n" if ($verbose);

$mcount=@match;
unless ($mcount > 0) {
  print "Nothing to do (no records to be updated)\n" if ($verbose);
  exit;
}

print "Updating dhcp_date for $mcount host records ...\n" if ($verbose);
unless ($commit) {
  print "Not updating records (missing --commit)\n";
  exit(1);
}

db_begin();
for $i (0..$#match) {
  $id=$match[$i][0];
  $t=$match[$i][1];
  $info=db_encode_str($match[$i][2]);
  $res=db_exec("UPDATE hosts SET dhcp_date=$t,dhcp_info=$info WHERE id=$id;");
  fatal("cannot update record id=$id") if ($res < 0);
}
fatal("cannot commit changes to database") if (db_commit() < 0);

print "Done.\n" if ($verbose);

exit 0;

